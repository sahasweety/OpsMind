# ─────────────────────────────────────────────────────────────────────────────
# OpsMind Simulator – Environment Variables
# Copy this file to .env for local (non-Docker) development only.
# When running via Docker Compose, these are injected through the
# `environment:` block in docker-compose.yml — do NOT create simulator/.env
# for Docker usage.
# ─────────────────────────────────────────────────────────────────────────────

# Port the simulator HTTP server listens on. (optional – default: 5001)
PORT=5001

# URL of the OpsMind ingest API.
# - Local dev (bare Node):  http://localhost:5000/api/ingest
# - Docker Compose:         http://server:5000/api/ingest  (set in docker-compose.yml)
INGEST_URL=http://localhost:5000/api/ingest

# ─── Required secrets ────────────────────────────────────────────────────────
# Obtain these from the OpsMind dashboard:
#   Dashboard → Project → Service → "Ingest Credentials"

# MongoDB ObjectId of the service this simulator will push logs to.
SERVICE_ID=your_service_object_id_here

# Plain-text ingest secret generated for the service (hashed & stored server-side).
INGEST_SECRET=your_ingest_secret_here
